{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["import", "jsdoc", "node", "unicorn"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "ignorePatterns": ["vendor/**"],
  "rules": {
    "no-console": ["warn", { "allow": ["warn", "error"] }],
    "no-unused-vars": ["warn", { "ignoreRestSiblings": true, "argsIgnorePattern": "^_" }],
    "prefer-const": "error",
    "eqeqeq": "error",
    "no-shadow": "off",
    "no-underscore-dangle": ["warn", { "allow": ["__dirname"] }],
    "unicorn/no-array-sort": "off"
  }
}
